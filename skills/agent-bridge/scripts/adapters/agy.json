{
  "bin": "agy",
  "stream_format": "agy-stream-json",
  "sid_key": "conversation_id",
  "effort_map": { "low": "low", "medium": "medium", "high": "high", "xhigh": "high", "max": "high" },
  "model_map": { "top": "gemini-3.6-flash", "gemini": "gemini-3.6-flash", "flash": "gemini-3.6-flash" },
  "model_args": ["--model", "{model}"],
  "cmd_new": [
    "--print", "{prompt}",
    "--output-format", "stream-json",
    "--add-dir", "{cwd}",
    "--dangerously-skip-permissions",
    "--print-timeout", "24h",
    "--effort", "{effort}",
    "{model_args}"
  ],
  "cmd_resume": [
    "--conversation", "{sid}",
    "--print", "{prompt}",
    "--output-format", "stream-json",
    "--add-dir", "{cwd}",
    "--dangerously-skip-permissions",
    "--print-timeout", "24h",
    "--effort", "{effort}",
    "{model_args}"
  ]
}
